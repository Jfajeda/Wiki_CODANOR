# =============================================================
# Wiki CODANOR — Variables de configuracion
# =============================================================
# Copiar este archivo como .env y rellenar con valores reales:
#   cp .env.example .env
# =============================================================

# NAS Synology
NAS_IP=192.168.1.XXX
NAS_SHARE=Wiki_Knowledge
NAS_MOUNT=/Volumes/Wiki_Knowledge
NAS_USER=admin

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

# Open WebUI
WEBUI_PORT=3000
WEBUI_URL=http://localhost:3000
